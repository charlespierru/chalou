<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Charles Pierru</title>
  <meta name="description" content="Charles Pierru — Musicien & Développeur">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Sans:opsz,wght@9..40,300;9..40,400&display=swap" rel="stylesheet">

  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --black:      #08070A;
      --surface:    #0F0D12;
      --gold:       #C8913A;
      --gold-pale:  #E0BA72;
      --cream:      #EDE5D8;
      --muted:      #7A7068;
      --border:     rgba(200, 145, 58, 0.25);
    }

    html, body {
      height: 100%;
    }

    body {
      background-color: var(--black);
      color: var(--cream);
      font-family: 'DM Sans', sans-serif;
      font-weight: 300;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100svh;
      overflow: hidden;
    }

    /* Grain texture */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='1'/%3E%3C/svg%3E");
      opacity: 0.03;
      pointer-events: none;
      z-index: 0;
    }

    /* Radial glow au centre */
    body::after {
      content: '';
      position: fixed;
      inset: 0;
      background: radial-gradient(ellipse 70% 60% at 50% 50%, rgba(200, 145, 58, 0.05) 0%, transparent 70%);
      pointer-events: none;
      z-index: 0;
    }

    /* Card */
    .card {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 3rem 2.5rem;
      gap: 0;
    }

    /* Photo */
    .photo-wrap {
      position: relative;
      width: 180px;
      height: 180px;
      margin-bottom: 2rem;
      opacity: 0;
      transform: translateY(12px);
      animation: rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.1s forwards;
    }

    .photo-wrap::before {
      content: '';
      position: absolute;
      inset: -3px;
      border-radius: 50%;
      background: conic-gradient(
        from 0deg,
        transparent 0deg,
        var(--gold) 90deg,
        var(--gold-pale) 180deg,
        var(--gold) 270deg,
        transparent 360deg
      );
      animation: spin 8s linear infinite;
    }

    .photo-wrap::after {
      content: '';
      position: absolute;
      inset: -3px;
      border-radius: 50%;
      background: radial-gradient(circle, transparent 80px, var(--black) 83px);
    }

    .photo-ring {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      overflow: hidden;
      z-index: 1;
    }

    .photo-ring img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 50%;
      display: block;
    }

    /* Nom */
    .name {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 300;
      font-size: clamp(2.4rem, 6vw, 3.6rem);
      letter-spacing: 0.06em;
      color: var(--cream);
      line-height: 1;
      margin-bottom: 0.55rem;
      opacity: 0;
      transform: translateY(10px);
      animation: rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.3s forwards;
    }

    /* Tagline */
    .tagline {
      font-family: 'Cormorant Garamond', serif;
      font-style: italic;
      font-weight: 300;
      font-size: clamp(1rem, 2.5vw, 1.2rem);
      color: var(--gold-pale);
      letter-spacing: 0.04em;
      margin-bottom: 1.8rem;
      opacity: 0;
      transform: translateY(10px);
      animation: rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.45s forwards;
    }

    /* Séparateur */
    .sep {
      width: 100%;
      max-width: 260px;
      height: 1px;
      background: linear-gradient(to right, transparent, var(--gold), transparent);
      margin-bottom: 1.6rem;
      opacity: 0;
      animation: fade 0.8s ease 0.6s forwards;
    }

    /* Instruments */
    .instruments {
      font-family: 'DM Sans', sans-serif;
      font-weight: 300;
      font-size: 0.72rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 2.4rem;
      opacity: 0;
      animation: rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.7s forwards;
    }

    .instruments span {
      color: rgba(200, 145, 58, 0.5);
      margin: 0 0.4em;
    }

    /* Liens */
    .links {
      display: flex;
      gap: 1rem;
      opacity: 0;
      animation: rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.85s forwards;
    }

    .link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.6rem 1.3rem;
      border: 1px solid var(--border);
      border-radius: 2px;
      text-decoration: none;
      color: var(--muted);
      font-size: 0.75rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-weight: 400;
      transition: color 0.3s ease, border-color 0.3s ease, background 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .link::before {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--gold);
      opacity: 0;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.35s ease;
    }

    .link:hover::before {
      transform: scaleX(1);
      opacity: 0.08;
    }

    .link:hover {
      color: var(--gold-pale);
      border-color: var(--gold);
    }

    .link svg {
      position: relative;
      z-index: 1;
      flex-shrink: 0;
      transition: color 0.3s ease;
    }

    .link span {
      position: relative;
      z-index: 1;
    }

    /* Animations */
    @keyframes rise {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes fade {
      to { opacity: 1; }
    }

    @keyframes spin {
      from { transform: rotate(0deg); }
      to   { transform: rotate(360deg); }
    }

    /* Mobile */
    @media (max-width: 480px) {
      .card {
        padding: 2rem 1.5rem;
      }

      .photo-wrap {
        width: 150px;
        height: 150px;
      }

      .photo-wrap::after {
        background: radial-gradient(circle, transparent 66px, var(--black) 69px);
      }

      .links {
        flex-direction: column;
        width: 100%;
      }

      .link {
        justify-content: center;
      }
    }
  </style>
</head>
<body>

  <main class="card" role="main">

    <div class="photo-wrap">
      <div class="photo-ring">
        <img
          src="https://github.com/charlespierru.png"
          alt="Charles Pierru"
          width="180"
          height="180"
        >
      </div>
    </div>

    <h1 class="name">Charles Pierru</h1>

    <p class="tagline">Musicien &amp; Développeur</p>

    <div class="sep" aria-hidden="true"></div>

    <p class="instruments">
      Instruments à vent
      <span>·</span>
      Guitare
      <span>·</span>
      Théorie
    </p>

    <nav class="links" aria-label="Liens">

      <a class="link" href="https://github.com/charlespierru" target="_blank" rel="noopener noreferrer">
        <!-- GitHub icon -->
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
