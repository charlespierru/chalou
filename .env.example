# Gabarit des réglages.
# À recopier sous le nom « .env » SUR LE SERVEUR, jamais dans le dépôt.

NODE_ENV=production

# Le service n'écoute que sur la machine elle-même ; nginx lui parle en local.
# 3002 est déclaré dans la politique de sécurité du serveur, à côté du 3001
# de l'autre application. Changer ce numéro impose de refaire cette
# déclaration, sinon nginx n'aura pas le droit de joindre le service.
PORT=3002

# L'archive des messages : base et compte propres à ce site, et à lui seul.
MONGO_URL=mongodb://UTILISATEUR:MOT_DE_PASSE@127.0.0.1:27017/chalou?authSource=chalou
MONGO_DB=chalou

# LE COURRIER — la règle de la maison, sans exception : mx.tonik.ink, port 587,
# TLS exigé, authentification. Le service REFUSE de démarrer autrement (voir
# le garde-fou en tête de server/src/config.js). Identifiant et mot de passe
# sont posés SUR LE SERVEUR par le guichet, jamais écrits ici.
SMTP_HOST=mx.tonik.ink
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=site@chalou.link
MAIL_TO=charles@chalou.link

# Anti-robot : durée minimale de remplissage du formulaire, en millisecondes.
DELAI_MINIMAL_MS=3000

# Conservation des messages, en mois. Annoncée sur la page « Mentions ».
CONSERVATION_MOIS=24

# Le webhook GitHub qui met FadeBeat à jour (chantier 94.b). Le secret partagé
# vit dans un fichier à part, posé par le guichet, lisible du seul service ;
# ici, seulement son chemin. Le dossier est celui que nginx sert sous
# /apps/fadebeat/, hors des versions du site.
GITHUB_WEBHOOK_SECRET_FILE=/etc/chalou/webhook-fadebeat
FADEBEAT_DOSSIER=/var/www/chalou.link/fadebeat
# Les deux adresses de GitHub ne changent qu'au banc d'essai (faux GitHub local).
# GITHUB_API_BASE=https://api.github.com
# GITHUB_RAW_BASE=https://raw.githubusercontent.com
